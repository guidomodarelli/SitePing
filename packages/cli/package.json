{
  "name": "@beezping/cli",
  "version": "0.5.6",
  "description": "CLI tool to set up Siteping in your project",
  "type": "module",
  "bin": {
    "siteping": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "siteping",
    "cli",
    "prisma",
    "setup",
    "developer-tools",
    "feedback",
    "nextjs",
    "prisma-generator",
    "typescript"
  ],
  "author": "neosianexus",
  "license": "MIT",
  "homepage": "https://siteping.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guidomodarelli/SitePing.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/guidomodarelli/SitePing/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@beezping/core": "workspace:*",
    "commander": "^15.0.0",
    "@clack/prompts": "^1.8.1",
    "@mrleebo/prisma-ast": "^0.16.0"
  }
}
