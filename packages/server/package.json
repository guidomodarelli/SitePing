{
  "name": "@siteping/server",
  "version": "0.0.0",
  "description": "Framework- and database-agnostic HTTP API for Siteping — pluggable auth, lifecycle hooks and any SitepingStore",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/fix-dts.mjs dist",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "siteping",
    "server",
    "handler",
    "feedback",
    "fetch-api",
    "typescript"
  ],
  "author": "neosianexus",
  "license": "MIT",
  "homepage": "https://siteping.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeosiaNexus/SitePing.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/NeosiaNexus/SitePing/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@siteping/adapter-memory": "workspace:*",
    "@siteping/core": "workspace:*"
  }
}
