{
  "name": "@beezping/adapter-memory",
  "version": "0.7.0",
  "description": "In-memory adapter for Beezping — zero dependencies, works everywhere",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/fix-dts.mjs dist",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "beezping",
    "memory",
    "adapter",
    "feedback",
    "testing",
    "demo",
    "typescript"
  ],
  "author": "neosianexus",
  "license": "MIT",
  "homepage": "https://github.com/guidomodarelli/beezping",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guidomodarelli/beezping.git",
    "directory": "packages/adapter-memory"
  },
  "bugs": {
    "url": "https://github.com/guidomodarelli/beezping/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@beezping/core": "workspace:*"
  }
}
