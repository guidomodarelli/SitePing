{
  "name": "@beezping/adapter-prisma",
  "version": "0.8.0",
  "description": "Prisma adapter for Beezping — server-side request handlers",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/fix-dts.mjs dist",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "beezping",
    "prisma",
    "adapter",
    "feedback",
    "api-handler",
    "nextjs",
    "feedback-api",
    "self-hosted",
    "typescript"
  ],
  "author": "neosianexus",
  "license": "MIT",
  "homepage": "https://github.com/guidomodarelli/beezping",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guidomodarelli/beezping.git",
    "directory": "packages/adapter-prisma"
  },
  "bugs": {
    "url": "https://github.com/guidomodarelli/beezping/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@beezping/server": "workspace:^"
  },
  "devDependencies": {
    "@beezping/core": "workspace:*",
    "@beezping/screenshot-storage": "workspace:*"
  },
  "peerDependencies": {
    "@prisma/client": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  }
}
