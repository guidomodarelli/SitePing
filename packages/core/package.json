{
  "name": "@beezping/core",
  "version": "0.7.2",
  "private": true,
  "description": "Shared types and schema definitions for @beezping packages",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "default": "./src/testing.ts"
    }
  },
  "author": "neosianexus",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/guidomodarelli/beezping",
  "bugs": {
    "url": "https://github.com/guidomodarelli/beezping/issues"
  },
  "keywords": [
    "beezping",
    "types",
    "schema",
    "feedback"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guidomodarelli/beezping.git",
    "directory": "packages/core"
  }
}
