# Database URL for Prisma (required for the demo with real database)
# DATABASE_URL="postgresql://user:password@localhost:5432/beezping"

# The demo runs with an in-memory store by default — no database required.
# To use a real database, uncomment DATABASE_URL and configure Prisma.

# Public origin of the deployed demo, used for Open Graph metadata, canonical
# and hreflang links, robots.txt and the sitemap. Read at build time; required
# by the Dockerfile (--build-arg). Local builds fall back to http://localhost:3000.
# BEEZPING_SITE_URL="https://demo.example.com"
