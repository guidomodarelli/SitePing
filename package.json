{
  "name": "beezping",
  "private": true,
  "description": "Client feedback widget \u2014 self-hosted, DOM-anchored annotations for websites",
  "homepage": "https://github.com/guidomodarelli/beezping",
  "type": "module",
  "author": "neosianexus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guidomodarelli/beezping.git"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/run-check.mjs build node node_modules/turbo/bin/turbo run build",
    "check": "node scripts/run-check.mjs check node node_modules/turbo/bin/turbo run check //#check:root",
    "check:root": "tsc --noEmit",
    "clean": "turbo run clean",
    "test": "vitest",
    "test:run": "node scripts/run-check.mjs tests node node_modules/vitest/vitest.mjs run",
    "test:e2e": "playwright test",
    "lint": "node scripts/run-check.mjs lint bun run --silent biome check .",
    "lint:fix": "biome check --write .",
    "verify": "bun run --silent build && bun run --silent check && bun run --silent lint && bun run --silent test:run && bun run --silent test:tooling",
    "pkg-checks": "node scripts/run-check.mjs pkg-checks node scripts/pkg-checks.mjs",
    "check:consistency": "node scripts/run-check.mjs consistency node scripts/check-consistency.mjs",
    "test:tooling": "node scripts/run-check.mjs tooling-tests node --test scripts/run-check.test.mjs",
    "knip": "knip",
    "new:locale": "node scripts/new-locale.mjs",
    "new:adapter": "node scripts/new-adapter.mjs",
    "create-version": "beez-rp create-version",
    "cv": "beez-rp create-version",
    "test:release": "node scripts/run-check.mjs release-tests node --test scripts/release/*.test.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.63.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-istanbul": "^5.0.1",
    "beez-rp": "0.6.0",
    "fast-check": "^4.10.1",
    "jsdom": "30.1.0",
    "knip": "^6.36.0",
    "publint": "0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "terser": "^5.51.2",
    "tsup": "^8.5.1",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.27",
    "sharp": "^0.35.4"
  }
}
